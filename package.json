{
  "name": "qvac-receipt-ocr",
  "version": "1.0.0",
  "description": "On-device receipt OCR demo using Tether QVAC SDK — private local inference, no cloud AI",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "qvac-receipt-ocr": "./src/index.js"
  },
  "scripts": {
    "start": "QVAC_CONFIG_PATH=./qvac.config.json node src/index.js",
    "ocr": "QVAC_CONFIG_PATH=./qvac.config.json node src/index.js",
    "demo": "QVAC_CONFIG_PATH=./qvac.config.json node src/index.js assets/sample-receipt.png"
  },
  "engines": {
    "node": ">=22.17.0",
    "npm": ">=10.9.0"
  },
  "keywords": [
    "qvac",
    "tether",
    "ocr",
    "receipt",
    "local-ai",
    "on-device"
  ],
  "author": "Kyle Petalik",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kylepetalik-max/qvac-receipt-ocr.git"
  },
  "dependencies": {
    "@qvac/sdk": "^0.19.1"
  }
}
